<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_pink">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top bar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:id="@+id/btn_menu"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Open menu"
                        android:focusable="true"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/maroon_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/btn_menu"
                        android:text="Meal Planner"
                        android:textColor="@color/maroon_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Day / Week / Month segmented toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_pill_inactive"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/toggle_day"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_active"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Day"
                        android:textColor="@color/maroon_dark"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/toggle_week"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Week"
                        android:textColor="@color/text_gray" />

                    <TextView
                        android:id="@+id/toggle_month"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="Month"
                        android:textColor="@color/text_gray" />
                </LinearLayout>

                <!-- ============ DAY TAB ============ -->
                <LinearLayout
                    android:id="@+id/day_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Date navigator -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_prev_day"
                            style="@style/NavArrowBadge"
                            android:layout_alignParentStart="true">

                            <ImageView
                                style="@style/NavArrowIcon"
                                android:src="@drawable/ic_chevron_left" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_selected_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="Saturday, 22 August 2026"
                            android:textColor="@color/maroon_primary"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_next_day"
                            style="@style/NavArrowBadge"
                            android:layout_alignParentEnd="true">

                            <ImageView
                                style="@style/NavArrowIcon"
                                android:src="@drawable/ic_chevron_right" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <!-- Breakfast slot -->
                    <LinearLayout style="@style/MealSlotHeaderRow">
                        <TextView style="@style/MealSlotTitle" android:text="Breakfast" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <include
                            android:id="@+id/slot_breakfast"
                            layout="@layout/item_recipe_horizontal" />

                        <include
                            android:id="@+id/empty_breakfast"
                            layout="@layout/item_meal_slot_empty" />
                    </FrameLayout>

                    <!-- Lunch slot -->
                    <LinearLayout style="@style/MealSlotHeaderRow">
                        <TextView style="@style/MealSlotTitle" android:text="Lunch" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <include
                            android:id="@+id/slot_lunch"
                            layout="@layout/item_recipe_horizontal" />

                        <include
                            android:id="@+id/empty_lunch"
                            layout="@layout/item_meal_slot_empty" />
                    </FrameLayout>

                    <!-- Dinner slot -->
                    <LinearLayout style="@style/MealSlotHeaderRow">
                        <TextView style="@style/MealSlotTitle" android:text="Dinner" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <include
                            android:id="@+id/slot_dinner"
                            layout="@layout/item_recipe_horizontal" />

                        <include
                            android:id="@+id/empty_dinner"
                            layout="@layout/item_meal_slot_empty" />
                    </FrameLayout>

                </LinearLayout>

                <!-- ============ WEEK TAB ============ -->
                <LinearLayout
                    android:id="@+id/week_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Week navigator -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_prev_week"
                            style="@style/NavArrowBadge"
                            android:layout_alignParentStart="true">

                            <ImageView
                                style="@style/NavArrowIcon"
                                android:src="@drawable/ic_chevron_left" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_week_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="18 - 24 August 2026"
                            android:textColor="@color/maroon_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_next_week"
                            style="@style/NavArrowBadge"
                            android:layout_alignParentEnd="true">

                            <ImageView
                                style="@style/NavArrowIcon"
                                android:src="@drawable/ic_chevron_right" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_week_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="7"
                        tools:listitem="@layout/item_week_day" />
                </LinearLayout>

                <!-- ============ MONTH TAB ============ -->
                <LinearLayout
                    android:id="@+id/month_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Month navigator -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_prev_month"
                            style="@style/NavArrowBadge"
                            android:layout_alignParentStart="true">

                            <ImageView
                                style="@style/NavArrowIcon"
                                android:src="@drawable/ic_chevron_left" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_month_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="August 2026"
                            android:textColor="@color/maroon_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_next_month"
                            style="@style/NavArrowBadge"
                            android:layout_alignParentEnd="true">

                            <ImageView
                                style="@style/NavArrowIcon"
                                android:src="@drawable/ic_chevron_right" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <!-- Weekday header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView style="@style/MonthWeekdayLabel" android:text="Sun" />
                        <TextView style="@style/MonthWeekdayLabel" android:text="Mon" />
                        <TextView style="@style/MonthWeekdayLabel" android:text="Tue" />
                        <TextView style="@style/MonthWeekdayLabel" android:text="Wed" />
                        <TextView style="@style/MonthWeekdayLabel" android:text="Thu" />
                        <TextView style="@style/MonthWeekdayLabel" android:text="Fri" />
                        <TextView style="@style/MonthWeekdayLabel" android:text="Sat" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_month_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="35"
                        tools:listitem="@layout/item_month_day" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <include layout="@layout/layout_bottom_nav" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/layout_nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
