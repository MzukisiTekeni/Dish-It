<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_pink">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav_container"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top bar: hamburger + title -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:id="@+id/btn_menu"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Open menu"
                        android:focusable="true"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/maroon_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="14dp"
                        android:layout_toEndOf="@id/btn_menu"
                        android:text="My Profile"
                        android:textColor="@color/maroon_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Profile summary card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="56dp"
                                android:layout_height="56dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    app:cardCornerRadius="28dp"
                                    app:cardElevation="0dp">

                                    <ImageView
                                        android:id="@+id/img_avatar"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="Profile photo"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_placeholder_avatar" />
                                </com.google.android.material.card.MaterialCardView>

                                <!-- Edit-photo badge, overlapping the avatar's bottom-right corner -->
                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/btn_edit_avatar"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="bottom|end"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@color/maroon_primary"
                                    app:cardCornerRadius="10dp"
                                    app:cardElevation="2dp">

                                    <ImageView
                                        android:layout_width="11dp"
                                        android:layout_height="11dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_camera"
                                        app:tint="@color/card_white" />
                                </com.google.android.material.card.MaterialCardView>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Leera, A"
                                    android:textColor="@color/maroon_primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_email"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Leera@gmail.com"
                                    android:textColor="@color/text_gray"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Stats row: Favourites / Meal plans / Grocery list -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_favourite"
                                    app:tint="@color/maroon_primary" />

                                <TextView
                                    android:id="@+id/tv_favourites_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="8"
                                    android:textColor="@color/maroon_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Favourites"
                                    android:textColor="@color/text_gray"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_meal_planner"
                                    app:tint="@color/maroon_primary" />

                                <TextView
                                    android:id="@+id/tv_meal_plans_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="4"
                                    android:textColor="@color/maroon_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Meal plans"
                                    android:textColor="@color/text_gray"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_grocery_list"
                                    app:tint="@color/maroon_primary" />

                                <TextView
                                    android:id="@+id/tv_grocery_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="13"
                                    android:textColor="@color/maroon_primary"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Grocery list"
                                    android:textColor="@color/text_gray"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- "Diet" section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Diet"
                    android:textColor="@color/maroon_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Dietary Preferences -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dietary Preferences"
                            android:textColor="@color/maroon_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Tap + to add one, hold a tag to remove it"
                            android:textColor="@color/text_gray"
                            android:textSize="11sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_diet_preferences"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="4"
                            tools:listitem="@layout/item_diet_chip" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/divider_light" />

                        <!-- Ingredients to avoid -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Ingredients to avoid"
                            android:textColor="@color/maroon_primary"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_diet_avoid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_diet_chip" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/divider_light" />

                        <!-- Favourite Cuisines -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Favourite Cuisines"
                            android:textColor="@color/maroon_primary"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_diet_cuisines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_diet_chip" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- "App Settings" section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="App Settings"
                    android:textColor="@color/maroon_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 5 fixed rows - a RecyclerView would be overkill here since
                     this list never grows or shrinks at runtime. -->
                <LinearLayout android:id="@+id/row_units" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowLabel" android:text="Units" />
                    <TextView android:id="@+id/tv_units_value" style="@style/SettingsRowValue" android:text="Metric(g, ml)" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" app:tint="@color/maroon_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_default_servings" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowLabel" android:text="Default Servings" />
                    <TextView android:id="@+id/tv_default_servings_value" style="@style/SettingsRowValue" android:text="2 people" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" app:tint="@color/maroon_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_notifications" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowLabel" android:text="Notifications" />
                    <TextView android:id="@+id/tv_notifications_value" style="@style/SettingsRowValue" android:text="On" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" app:tint="@color/maroon_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_theme" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowLabel" android:text="Theme" />
                    <TextView android:id="@+id/tv_theme_value" style="@style/SettingsRowValue" android:text="System" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" app:tint="@color/maroon_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_language" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowLabel" android:text="Language" />
                    <TextView android:id="@+id/tv_language_value" style="@style/SettingsRowValue" android:text="English" />
                    <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_chevron_right" app:tint="@color/maroon_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/row_sign_out" style="@style/SettingsRow">
                    <TextView style="@style/SettingsRowLabel" android:text="Sign Out" />
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_sign_out" app:tint="@color/maroon_primary" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/bottom_nav_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <include layout="@layout/layout_bottom_nav" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        layout="@layout/layout_nav_drawer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
