<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_picker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Choose a Breakfast recipe"
        android:textColor="@color/maroon_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Same item_recipe_horizontal.xml row + RecipeListAdapter that Recipe
         Book itself uses, so a recipe looks identical here as it does there -
         image, time, servings, rating, tag, all visible before picking. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_picker_recipes"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_recipe_horizontal" />

</LinearLayout>
